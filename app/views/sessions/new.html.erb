<% content_for :title, "Sign In" %>

<section class="auth-card">
  <div>
    <p class="eyebrow">InsightPulse</p>
    <h1>Sign in</h1>
    <p class="subtle">Manage surveys, collect responses, and prepare AI-ready research outputs.</p>
  </div>

  <%= form_with url: session_path, scope: :session, class: "stack" do |form| %>
    <div class="field">
      <%= form.label :email_address, "Email" %>
      <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username", value: params[:email_address] %>
    </div>

    <div class="field">
      <%= form.label :password, "Password" %>
      <%= form.password_field :password, required: true, autocomplete: "current-password", maxlength: 72 %>
    </div>

    <div class="actions">
      <%= form.submit "Sign in", class: "button button--primary" %>
      <%= link_to "Forgot password?", new_password_path, class: "button button--secondary" %>
    </div>
  <% end %>
</section>
