# Copy this file to .env and fill in the values you need.
# .env is gitignored — never commit real keys.

# Powers the AI survey summary (AiReportGenerator / AiSummary::AnthropicProvider).
# Falls back to a local heuristic if unset.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-3-5-haiku-latest

# Powers the "Enhance with AI" question wording button (QuestionEnhancer / QuestionEnhancement::OpenAiProvider).
# Falls back to a local heuristic if unset.
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
